# Local-only example. Copy to .env and replace placeholders; never commit .env.
ALCHEMY_API_KEY=replace-with-your-provider-key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/replace-with-your-provider-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blockchain_analytics
API_KEY=replace-with-a-long-random-secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blockchain_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
OLLAMA_URL=http://localhost:11434
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_RATE_LIMIT_PER_MINUTE=120
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=240
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
# Configure separate signing and analyst credentials before enabling public access.
# ANALYST_API_KEY=replace-with-another-long-random-secret
# ANALYST_SESSION_SIGNING_KEY=replace-with-another-long-random-secret
