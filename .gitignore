# ============================================
# VIRTUAL ENVIRONMENT
# Each computer rebuilds this — no need to share
# ============================================
.venv/
venv/
env/

# ============================================
# ENVIRONMENT VARIABLES (CRITICAL!)
# Contains API keys and secrets — NEVER share
# ============================================
.env
.env.local
.env.*.local

# ============================================
# PYTHON CACHE & BUILD FILES
# Auto-generated by Python — always safe to ignore
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ============================================
# TESTING & COVERAGE
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ============================================
# EDITORS & IDEs
# Your personal editor settings don't matter to others
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# OPERATING SYSTEM FILES
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# LOGS
# ============================================
*.log
logs/

# ============================================
# DATA & DATABASES
# ============================================
data/
*.db
*.sqlite
*.sqlite3

# ============================================
# NODE.JS (for frontend later)
# ============================================
node_modules/
frontend/build/
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# DOCKER
# ============================================
postgres-data/
redis-data/backups/
backups/
